# คัดลอกไฟล์นี้เป็น .env.local (เครื่องตัวเอง) หรือใส่ค่าเดียวกันใน Vercel → Settings → Environment Variables

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ ความลับ — ใส่เฉพาะใน Vercel / .env.local ห้าม commit ห้ามส่งในแชต
SUPABASE_SERVICE_ROLE_KEY=

# LINE Developers → LINE Login channel → Basic settings
LINE_LOGIN_CHANNEL_ID=
# ⚠️ ความลับ
LINE_LOGIN_CHANNEL_SECRET=
# (ไม่บังคับ) ชวนเพิ่มเพื่อน LINE OA ตอนล็อกอิน: normal หรือ aggressive — ต้องผูก OA กับ Login channel ก่อน
LINE_BOT_PROMPT=

# ที่อยู่เว็บจริง ต้องตรงกับ Callback URL ที่ลงทะเบียนใน LINE (ไม่มี / ปิดท้าย)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# แสดงในหน้าตั้งค่า/นโยบายความเป็นส่วนตัว
NEXT_PUBLIC_SUPPORT_CONTACT=LINE @yourshop
NEXT_PUBLIC_CONTROLLER_NAME=ชื่อร้านหรือชื่อผู้ให้บริการ
